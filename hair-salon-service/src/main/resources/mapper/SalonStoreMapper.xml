<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wangjin.salon.service.mapper.SalonStoreMapper">

    <select id="getStorePage" resultType="com.wangjin.salon.service.model.vo.StorePageVO">
        SELECT
            s.id, s.name, s.code, s.phone, s.address,
            s.business_hours, s.open_time, s.close_time, s.rest_days,
            s.status, s.sort, s.remark, s.create_time
        FROM salon_store s
        <where>
            s.deleted = 0
            <if test="q.keywords != null and q.keywords != ''">
                AND (
                    s.name LIKE CONCAT('%', #{q.keywords}, '%')
                    OR s.code LIKE CONCAT('%', #{q.keywords}, '%')
                    OR s.phone LIKE CONCAT('%', #{q.keywords}, '%')
                    OR s.address LIKE CONCAT('%', #{q.keywords}, '%')
                )
            </if>
            <if test="q.status != null">
                AND s.status = #{q.status}
            </if>
            <if test="q.tenantId != null">
                AND s.tenant_id = #{q.tenantId}
            </if>
            <if test="q.allStoreScope == null or q.allStoreScope == false">
                <choose>
                    <when test="q.deniedStoreScope == true">
                        AND 1 = 0
                    </when>
                    <otherwise>
                        AND (
                            <trim prefixOverrides="OR">
                                <if test="q.permittedStoreIds != null and q.permittedStoreIds.size > 0">
                                    OR s.id IN
                                    <foreach collection="q.permittedStoreIds" item="storeId" open="(" separator="," close=")">
                                        #{storeId}
                                    </foreach>
                                </if>
                                <if test="q.permissionUserId != null">
                                    OR s.create_by = #{q.permissionUserId}
                                </if>
                            </trim>
                        )
                    </otherwise>
                </choose>
            </if>
        </where>
        ORDER BY s.sort ASC, s.create_time DESC
    </select>
</mapper>
