<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wangjin.salon.system.mapper.SysMenuMapper">

    <resultMap id="RouteMap" type="com.wangjin.salon.system.model.bo.RouteBO">
        <id property="id" column="id"/>
        <result property="parentId" column="parent_id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="path" column="path"/>
        <result property="component" column="component"/>
        <result property="redirect" column="redirect"/>
        <result property="meta" column="meta"
                typeHandler="com.wangjin.salon.system.handler.MetaJsonTypeHandler"/>
        <result property="perm" column="perm"/>
    </resultMap>

    <!-- 非按钮菜单；角色列表在 Service 层按需补充也可，一期先出路由树 -->
    <select id="listRoutes" resultMap="RouteMap">
        SELECT
            m.id,
            m.parent_id,
            m.name,
            m.type,
            m.path,
            m.component,
            m.redirect,
            m.meta,
            m.perm
        FROM sys_menu m
        WHERE m.deleted = 0
          AND m.type != 4
        ORDER BY m.id
    </select>

    <select id="listRolePerms" resultType="string">
        SELECT DISTINCT m.perm
        FROM sys_menu m
        INNER JOIN sys_role_menu rm ON m.id = rm.menu_id
        INNER JOIN sys_role r ON rm.role_id = r.id AND r.deleted = 0 AND r.status = 1
        WHERE m.deleted = 0
          AND m.perm IS NOT NULL
          AND m.perm != ''
          AND r.code IN
        <foreach collection="roles" item="role" open="(" separator="," close=")">
            #{role}
        </foreach>
    </select>
</mapper>
