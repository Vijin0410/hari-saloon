<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wangjin.salon.system.mapper.SysRoleMapper">

    <select id="getMaxDataRangeDataScope" resultType="java.lang.Integer">
        SELECT MIN(data_scope)
        FROM sys_role
        WHERE deleted = 0
        <if test="roles != null and roles.size() > 0">
            AND code IN
            <foreach collection="roles" item="r" open="(" separator="," close=")">
                #{r}
            </foreach>
        </if>
        <if test="roles == null or roles.size() == 0">
            AND 1 = 0
        </if>
    </select>
</mapper>
